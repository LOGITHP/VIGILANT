# VIGILANT Environment Configuration

# Project & Environment
PROJECT_NAME="VIGILANT"
ENVIRONMENT=production

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vigilant_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/vigilant_db

# Security & Tokens
JWT_SECRET=vigilant_super_secure_jwt_secret_change_in_production_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Super Admin Seed Credentials (Provisioned on first container boot, then wiped)
INITIAL_ADMIN_EMAIL=cctv@gmail.com
INITIAL_ADMIN_PASSWORD=123456789

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
PORT=5173
BACKEND_PORT=8000

